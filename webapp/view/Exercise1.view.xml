    <mvc:View xmlns:mvc="sap.ui.core.mvc" 
        xmlns="sap.m"             
        xmlns:l="sap.ui.layout"
        xmlns:f="sap.ui.layout.form"
        xmlns:core="sap.ui.core"
        controllerName="exercise1.controller.Exercise1">
        <Page id="page" title="{i18n>title}">
            <f:SimpleForm editable="true" id="SimpleForm" 
                layout="ResponsiveGridLayout"
            >
            
            <Label text="Name"  id="Name"/>
            <Input id="NameInput" value="{/Name}"/>

            <Label id="StreetNo" text="Street/No">            
            </Label>
            <Input id="StreetInput" value="{/Street}">
            <layoutData>
            <l:GridData id="StreetInputGrid" span="L6 M6 S10"></l:GridData>
            </layoutData>
            </Input>
            <Input id="NoInput" value="{/HouseNo}">
            <layoutData>
            <l:GridData id="NoInputGrid" span="L4 M4 S10"></l:GridData>
            </layoutData>
            </Input>

            <Label id="ZipCodeCity" text="Zip Code/City"></Label>
            <Input id="ZipCodeInput" value="{/ZipCode}">
            <layoutData>
            <l:GridData id="ZipCodeInputGrid" span="L4 M4 S10"></l:GridData>
            </layoutData>
            </Input>
            <Input id="CityInput" value="{/City}">
            <layoutData>
            <l:GridData id="CityInputGrid" span="L6 M6 S10"></l:GridData>
            </layoutData>
            </Input>


            <Label text="Country" id="Country"/>
            <Select 
                id="Select"
                selectedKey="{/SelectedCountry}"
                items="{ path: '/ListofCountries' }"> 
                    <core:Item id="Item" key="{Country}" text="{Country}"></core:Item>
            </Select>


           <!-- 
            <Toolbar id="Toolbar1">
            <ToolbarSpacer id="ToolbarSpacer1"/>
            <Button text="Save" type="Emphasized" id="save" press="onSave"/>
            <Button text="Clear" id="clr" press="onClear"/>
            </Toolbar>
            -->


            </f:SimpleForm>
        </Page>
    </mvc:View>