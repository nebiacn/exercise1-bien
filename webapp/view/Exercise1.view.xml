    <mvc:View xmlns:mvc="sap.ui.core.mvc" 
        xmlns="sap.m"             
        xmlns:l="sap.ui.layout"
        xmlns:f="sap.ui.layout.form"
        xmlns:core="sap.ui.core"
        controllerName="exercise1.controller.Exercise1">
        <Page id="page" title="{i18n>title}">
            <f:SimpleForm editable="true" id="SimpleForm" 
                layout="ResponsiveGridLayout"
            >
            
            <Label text="Name"  id="Name"/>
            <Input id="NameInput"/>

            <Label id="StreetNo" text="Street/No">            
            </Label>
            <Input id="StreetInput">
            <layoutData>
            <l:GridData id="StreetInputGrid" span="L6 M6 S10"></l:GridData>
            </layoutData>
            </Input>
            <Input id="NoInput">
            <layoutData>
            <l:GridData id="NoInputGrid" span="L4 M4 S10"></l:GridData>
            </layoutData>
            </Input>

            <Label id="ZipCodeCity" text="Zip Code/City"></Label>
            <Input id="ZipCodeInput">
            <layoutData>
            <l:GridData id="ZipCodeInputGrid" span="L4 M4 S10"></l:GridData>
            </layoutData>
            </Input>
            <Input id="CountryInput">
            <layoutData>
            <l:GridData id="CountryInputGrid" span="L6 M6 S10"></l:GridData>
            </layoutData>
            </Input>


            <Label text="Country" id="Country"/>
            <Select 
                id="Select"
                selectedKey="{/SelectedCountry}"
                items="{ path: '/ListofCountries' }"> 
                    <core:Item id="Item" key="{Country}" text="{Country}"></core:Item>
            </Select>


            
            <Toolbar id="Toolbar1">
            <ToolbarSpacer id="ToolbarSpacer1"/>
            <Button text="Save" type="Emphasized" id="save"/>
            <Button text="Clear" id="clr"/>
            </Toolbar>


            </f:SimpleForm>
        </Page>
    </mvc:View>